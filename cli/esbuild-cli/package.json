{
  "name": "@noodlestan/esbuild",
  "version": "0.1.0",
  "description": "esbuild build/watch wrapper for Noodlestan packages",
  "keywords": [
    "cli",
    "esbuild",
    "build",
    "tooling",
    "configs"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/workspace-tooling.git",
    "directory": "cli/esbuild-cli"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./plugins": "./src/plugins/index.mjs"
  },
  "bin": {
    "esbuild-cli": "./bin/build.mjs",
    "esbuild-cli-watch": "./bin/watch.mjs"
  },
  "scripts": {
    "lint": "prettier . -c && eslint --ext .mjs .",
    "lint:fix": "prettier . -c --write && eslint --ext .mjs . --fix",
    "test": "echo no tests yet",
    "ci": "npm run lint"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "esbuild-plugin-file-path-extensions": "2.1.4"
  }
}
