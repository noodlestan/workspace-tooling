{
  "name": "@noodlestan/workspace-tooling",
  "version": "0.0.11",
  "description": "Esbuild CLI wrapper, ESLint config, and base TypeScript configs.",
  "keywords": [
    "tooling",
    "configs"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:noodlestan/workspace-tooling.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "cli/*",
    "configs/*"
  ],
  "bin": {
    "noodlestan/esbuild-cli": "cli/esbuild-cli/bin/build.mjs",
    "noodlestan/esbuild-cli-watch": "cli/esbuild-cli/bin/watch.mjs"
  },
  "prettier": "@noodlestan/prettier-config",
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c ",
    "lint:fix": "prettier . -c --write ",
    "extract": "echo no purrception yet",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "esbuild-plugin-file-path-extensions": "2.1.4"
  },
  "devDependencies": {
    "@noodlestan/conventions-typescript": "0.1.0",
    "@noodlestan/conventions-unit-tests": "0.1.0",
    "@noodlestan/eslint-config": "0.0.8",
    "@noodlestan/prettier-config": "0.1.0",
    "@types/node": "24.13.0",
    "eslint": "8.57.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
